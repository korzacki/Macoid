. "$MACOID/lib/common.sh"
P=/sys/class/power_supply/battery
echo "+-o Root  <class IORegistryEntry>"
echo "  +-o $(prop ro.product.model)  <class IOPlatformExpertDevice>"
echo "    | \"model\" = <\"$(prop ro.product.model)\">"
echo "    | \"manufacturer\" = <\"$(prop ro.product.manufacturer)\">"
echo "    +-o AppleSmartBattery  <class AppleSmartBattery>"
echo "        \"CurrentCapacity\" = $(cat $P/capacity 2>/dev/null || echo 0)"
echo "        \"IsCharging\" = $( [ "$(cat $P/status 2>/dev/null)" = Charging ] && echo Yes || echo No)"
echo "        \"Temperature\" = $(cat $P/temp 2>/dev/null || echo 0)"
echo "        \"Voltage\" = $(( $(cat $P/voltage_now 2>/dev/null || echo 0) / 1000 ))"
