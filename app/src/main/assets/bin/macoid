#!/system/bin/sh
. "$MACOID/lib/common.sh"
sub=$1; [ $# -gt 0 ] && shift
count() { cat "$MACOID/lib/maccmds.txt" "$MACOID/lib/maccmds.extra" 2>/dev/null | grep -v '^#' | tr -s ' ' '\n' | grep -E '^[A-Za-z0-9_+.-]+$' | sort -u | wc -l; }
case "$sub" in
  motd) echo "Welcome to Macoid $MACOID_VERSION - a macOS-style terminal for Android (real PTY terminal)."
        echo "Type 'macoid help' for commands. Real git/gh built in; pip/npm/apk/brew install instantly on the phone (pkg help)."
        echo "Rooted phone? Use the # button (root session), 'tsu' (root shell) or 'sudo <cmd>'.";;
  version|--version) echo "Macoid $MACOID_VERSION";;
  cloud) . "$MACOID/lib/cloud.sh"; cloud_cmd "$@";;
  build) . "$MACOID/lib/cloud.sh"; build_cmd "$@";;
  commands|list)
    echo "Built in (run locally):"; ls "$MACOID/bin" "$HOME/.local/bin" 2>/dev/null | grep -v ':' | sort -u | tr '\n' ' '; echo; echo
    echo "macOS catalog (run on a real Mac in the cloud): $(count) names - see 'brew search <text>'";;
  sync-commands)
    echo "[macoid] asking a real Mac for its full command list..." >&2
    d="$TMPDIR/sync.$$"; mkdir -p "$d"; ( cd "$d" && sh "$MACOID/bin/macoid" cloud --os macos --fetch --sh 'ls /bin /sbin /usr/bin /usr/sbin /usr/local/bin /opt/homebrew/bin 2>/dev/null | grep -E "^[A-Za-z0-9_+.-]+$" | sort -u > maccmds-synced.txt; wc -l maccmds-synced.txt' )
    if [ -s "$d/maccmds-synced.txt" ]; then
      { echo "# synced $(date +%F)"; tr '\n' ' ' < "$d/maccmds-synced.txt"; echo; } > "$MACOID/lib/maccmds.extra"
      echo "[macoid] catalog now has $(count) names. Open a new tab to load them." >&2
    else echo "sync failed: no list came back" >&2; fi
    rm -rf "$d";;
  installs)
    . "$MACOID/lib/installs.sh"
    case "$1" in
      ""|list) inst_list;;
      clear) rm -f "$INST_FILE" "$BINS_FILE"; echo "Cleared saved installs.";;
      rm|remove) [ -z "$2" ] && die "usage: macoid installs rm <package>"; inst_remove "$2" && echo "Removed $2." || die "$2: not in saved installs";;
      *) die "usage: macoid installs [list|rm <package>|clear]";;
    esac;;
  root)
    . "$MACOID/lib/root.sh"
    case "$1" in
      ""|status)
        SU=$(root_su) || { echo "[--] su not found: this phone is not rooted"; exit 1; }
        echo "[ok] su binary: $SU"
        if [ "$(id -u)" = 0 ]; then echo "[ok] this shell is root ($(id))"
        else
          out=$("$SU" -c id 2>&1) && echo "[ok] root granted: $out" || echo "[!!] root denied or failed: $out"
        fi;;
      fixperms)
        # files created as root inside the app folder can lock the normal shell out; give them back to the app user
        [ -n "$MACOID_UID" ] || die "macoid root fixperms: MACOID_UID missing"
        _sd="/system/bin/sh $MACOID/bin/sudo"; $_sd chown -R "$MACOID_UID:$MACOID_UID" "$MACOID" && { $_sd restorecon -R "$MACOID" 2>/dev/null; true; }; echo "Ownership of $MACOID reset to uid $MACOID_UID.";;
      *) die "usage: macoid root [status|fixperms]";;
    esac;;
  doctor)
    echo "Macoid $MACOID_VERSION"
    [ -f "$MACOID_APK" ] && echo "[ok] APK classpath: $MACOID_APK" || echo "[!!] APK not found"
    git --version >/dev/null 2>&1 && echo "[ok] git (JGit) works" || echo "[!!] git failed (JVM tools unavailable)"
    gh auth status >/dev/null 2>&1 && echo "[ok] GitHub login" || echo "[--] not logged in to GitHub (gh auth login)"
    . "$MACOID/lib/root.sh"; _su=$(root_su) && echo "[ok] su found: $_su (macoid root status to test)" || echo "[--] no su: not rooted (root features disabled)"
    . "$MACOID/lib/linux.sh"
    if lx_ready; then echo "[ok] local Linux (Alpine) ready - pkg/pip/npm/apk install instantly"
    elif [ -x "$LXPROOT" ]; then echo "[--] Linux engine downloaded, Alpine not unpacked yet (run: pkg setup)"
    else echo "[--] local Linux not set up yet (first pkg/pip/npm install sets it up, ~5 MB)"; fi
    echo "[..] catalog size: $(count)";;
  help|"")
    cat <<'TXT'
Macoid - macOS-style terminal for Android

  git ...                 real git (clone, commit, push, pull, branch, merge, rebase, stash, tag ...)
  gh auth login           log in to GitHub with a token, then:
  gh repo|issue|pr|run|workflow|release|api ...
  macoid build [target]   compile your project on GitHub Actions (android-apk, android-aab, ios, macos,
                          swift, flutter-apk, gradle-java, maven, node, electron, python, go, rust,
                          cmake, dotnet) and download the result into ./build-output
  macoid cloud [--os macos|ubuntu|windows] [--fetch] -- <cmd...>   run any command on a real runner
  pkg install <name...>   install software ON THE PHONE, instantly (local Alpine Linux, no GitHub runner)
                          also: pkg remove|search|list|update|upgrade|shell|doctor, apk, apt, apt-get, brew install
  pip / npm / yarn / pnpm / gem / cargo / go    run locally and install on first use (pip install requests)
  lx [cmd ...]            open a Linux shell, or run one command inside the local Linux
  macoid installs         (legacy cloud installs) list what was installed on the cloud Mac
  macoid sync-commands    pull the real command list from a Mac (extends the catalog)
  macoid root [status|fixperms]   check su access / repair file ownership after working as root
  macoid commands|doctor|version
  skill install|list|run|new|search ...   install and run skills (folders with a SKILL.md); try: skill examples

macOS-style commands run locally: open pbcopy pbpaste say afplay osascript defaults sw_vers sysctl
system_profiler scutil pmset ioreg vm_stat diskutil ifconfig networksetup launchctl mdfind mdls ditto
trash tree md5 shasum uuidgen brew man softwareupdate xcode-select caffeinate zip unzip curl wget host dig

Developer tools from the catalog (python, node, gcc, clang, make, cmake, cargo, go, ruby, awk, rsync, ssh,
tmux, htop ...) run locally in the on-phone Linux, installed on first use. Apple tools: plutil, PlistBuddy, lipo,
otool, install_name_tool, dwarfdump, sips run on the phone; swift/swiftc/swift build run on a quick Linux runner (a real
Mac only for SwiftUI/UIKit code); xcodebuild, codesign, simctl ... still need a real Mac. Set MACOID_LINUX=0 to force the cloud.
Aliases you create with 'alias name=value' are saved and come back after restart ('unalias' removes them).
Root (rooted phones only): '+' tab = normal shell, '#' tab = root shell via su. In a normal shell: tsu (root shell),
sudo <cmd> (one command as root). The root shell has its own home (root-home); 'macoid root fixperms' repairs ownership.
Editors: nano/vi/vim/edit <file> open a built-in editor (root-aware). setup-storage grants access to ~/storage.
This is a real terminal now: top, vim-style full-screen programs, colours, Ctrl-keys and arrow keys all work.
TXT
    ;;
  *) echo "macoid: unknown command '$sub'. Try: macoid help" >&2; exit 1;;
esac
