. "$MACOID/lib/common.sh"
p() { echo $(( $(mem_kb "$1") / 4 )); }
echo "Mach Virtual Memory Statistics: (page size of 4096 bytes)"
echo "Pages free:                          $(p MemFree)."
echo "Pages active:                        $(p Active)."
echo "Pages inactive:                      $(p Inactive)."
echo "Pages wired down:                    $(p Unevictable)."
echo "File-backed pages:                   $(p Cached)."
echo "Swap total (pages):                  $(p SwapTotal)."
