#!/system/bin/sh
# brew - the GENUINE Homebrew (https://brew.sh), installed with Homebrew's own installer
#   https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
# Homebrew has no Android support (it needs glibc and /home/linuxbrew/.linuxbrew, and refuses to run as root), so it runs as
# Homebrew on Linux inside Macoid's real Debian (glibc, proot), as a normal user "linuxbrew". Nothing here reimplements brew:
# every command below is passed straight to the real /home/linuxbrew/.linuxbrew/bin/brew.
. "$MACOID/lib/common.sh"
MACOID_DISTRO=debian; export MACOID_DISTRO
. "$MACOID/lib/linux.sh"
[ "$LX_DISTRO" = debian ] || die "brew: Homebrew needs glibc; this needs the Debian Linux (pkg distro debian)"
case "$(uname -m)" in aarch64|arm64|x86_64|amd64) ;; *) die "brew: Homebrew on Linux supports only 64-bit ARM and x86_64 (this CPU: $(uname -m))";; esac

BREW_PREFIX=/home/linuxbrew/.linuxbrew
# run a command inside the Debian as the normal user linuxbrew (uid 1000), not as root
brew_user() {
  LX_ID_FLAG="-i 1000:1000" LX_HOME=/home/linuxbrew LX_USER=linuxbrew LX_PATH_PRE="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:" \
    _lx_proot "$@"
}

brew_setup() {
  [ -f "$LXROOT/home/linuxbrew/.macoid-brew-ok" ] && return 0
  lx_setup || return 1
  echo "==> Homebrew: preparing the Debian Linux (build tools, git, curl)" >&2
  lx_pkg_add build-essential procps curl file git ca-certificates || return 1
  # normal user: Homebrew refuses to run as root
  grep -q '^linuxbrew:' "$LXROOT/etc/passwd" 2>/dev/null || echo 'linuxbrew:x:1000:1000:Linuxbrew:/home/linuxbrew:/bin/bash' >> "$LXROOT/etc/passwd"
  grep -q '^linuxbrew:' "$LXROOT/etc/group" 2>/dev/null || echo 'linuxbrew:x:1000:' >> "$LXROOT/etc/group"
  mkdir -p "$LXROOT$BREW_PREFIX" "$LXROOT/home/linuxbrew"
  _lx_proot chown -R 1000:1000 /home/linuxbrew || return 1
  if [ ! -x "$LXROOT$BREW_PREFIX/bin/brew" ]; then
    echo "==> Homebrew: running the official installer from github.com/Homebrew/install" >&2
    brew_user env NONINTERACTIVE=1 CI=1 /bin/bash -c 'curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o /tmp/brew-install.sh && /bin/bash /tmp/brew-install.sh' || {
      echo "brew: the official Homebrew installer failed (see above). Nothing else was changed." >&2; return 1; }
  fi
  [ -x "$LXROOT$BREW_PREFIX/bin/brew" ] || { echo "brew: installer finished but $BREW_PREFIX/bin/brew is missing" >&2; return 1; }
  : > "$LXROOT/home/linuxbrew/.macoid-brew-ok"
  echo "==> Homebrew is ready." >&2
}

brew_setup || exit 1
cd "$HOME" 2>/dev/null
brew_user "$BREW_PREFIX/bin/brew" "$@"
