P=/sys/class/power_supply/battery
cap=$(cat $P/capacity 2>/dev/null || echo ?); st=$(cat $P/status 2>/dev/null || echo unknown)
case "$st" in Charging) src="AC Power"; s2=charging;; Full) src="AC Power"; s2=charged;; *) src="Battery Power"; s2=discharging;; esac
case "$1 $2" in
  "-g batt"|"-g ps") echo "Now drawing from '$src'"; printf ' -InternalBattery-0\t%s%%; %s; present: true\n' "$cap" "$s2";;
  "-g "|"-g log") echo "System-wide power settings:"; echo "Currently in use:"; echo " powersource  $src";;
  *) echo "usage: pmset -g [batt|ps]   (changing power settings is not supported on Android)" >&2; exit 1;;
esac
