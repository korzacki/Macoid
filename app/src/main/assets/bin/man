[ -z "$1" ] && { echo "What manual page do you want?" >&2; exit 1; }
c=$1
if "$c" --help >/dev/null 2>&1 && ! alias "$c" >/dev/null 2>&1; then "$c" --help 2>&1 | head -n 80; exit 0; fi
echo "[macoid] fetching the real macOS manual page for '$c' from a Mac runner..." >&2
sh "$MACOID/bin/macoid" cloud --os macos --sh "man $c | col -b | head -n 300"
