#!/system/bin/sh
case "$1" in
  -p|--print-path) echo /Applications/Xcode.app/Contents/Developer;;
  --install) echo "Real Xcode cannot run on a phone. Fast alternatives are built in:"
             echo "  - swift / swiftc / swift build run on a quick Linux runner (a real Mac only if you import SwiftUI, UIKit ...)"
             echo "  - plutil, PlistBuddy, lipo, otool, install_name_tool, dwarfdump, sips run on the phone, instantly"
             echo "  - xcodebuild and 'macoid build ios' still need a real Mac (GitHub runner)";;
  --version|-v) echo "xcode-select version 2399 (Macoid)";;
  *) echo "usage: xcode-select -p | --install | --version" >&2; exit 1;;
esac
