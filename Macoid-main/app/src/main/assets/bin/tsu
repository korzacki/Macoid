#!/system/bin/sh
# tsu - open a root shell (like Termux's tsu). Needs a rooted phone; approve the su prompt.
. "$MACOID/lib/common.sh"
. "$MACOID/lib/root.sh"
[ "$(id -u)" = 0 ] && die "tsu: already root"
root_need tsu
ef=$(root_envfile)
cwd=$(printf '%s' "$PWD" | sed "s/'/'\\\\''/g")
"$SU" -c ". '$ef'; cd '$cwd' 2>/dev/null || cd \"\$HOME\"; exec /system/bin/sh -i"
rc=$?
rm -f "$ef"
exit $rc
