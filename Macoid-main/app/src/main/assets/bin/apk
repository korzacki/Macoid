#!/system/bin/sh
# apk - Alpine's package manager. Only when the local Linux is Alpine (pkg distro alpine); on Debian use pkg / apt.
. "$MACOID/lib/linux.sh"
if [ "$LX_DISTRO" != alpine ]; then
  echo "apk: this Linux is $LX_DISTRO, not Alpine. Use 'pkg install ...' / 'apt install ...' (or 'pkg distro alpine' to switch)." >&2; exit 1
fi
lx_setup || exit 1
case "$1" in
  add) shift; lx_pkg_add "$@"; exit $?;;          # keeps the package index on disk, so it is fast
  update) lx_pkg_update; exit $?;;
esac
_lx_proot /sbin/apk "$@"; rc=$?
case "$1" in del|upgrade|fix) lx_sync_bins;; esac
exit $rc
