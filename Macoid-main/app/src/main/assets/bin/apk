#!/system/bin/sh
# apk - Alpine's own package manager, straight through
. "$MACOID/lib/linux.sh"
lx_setup || exit 1
case "$1" in
  add) shift; lx_apk_add "$@"; exit $?;;          # keeps the package index on disk, so it is fast
  update) lx_apk_update; exit $?;;
esac
_lx_proot /sbin/apk "$@"; rc=$?
case "$1" in del|upgrade|fix) lx_sync_bins;; esac
exit $rc
