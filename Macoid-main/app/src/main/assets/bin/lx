#!/system/bin/sh
# lx - the real Linux on this phone.   lx                    -> shell
#                                      lx <cmd> ...          -> run <cmd> there
#                                      lx distro [name]      -> show / switch distro (debian | alpine)
#                                      lx arch [name]        -> show / choose CPU arch (arm64 | arm | x86_64 | default)
. "$MACOID/lib/linux.sh"
if [ $# -eq 0 ]; then lx_shell; exit $?; fi
case "$1" in
  -c) shift; lx_setup || exit 1; lx_run /bin/sh -c "$@"; exit $?;;
  distro) shift; if [ $# -eq 0 ]; then echo "$LX_DISTRO"; else lx_use "$1" && echo "Linux is now '$1' (set up on first use)."; fi; exit $?;;
  arch) shift; if [ $# -eq 0 ]; then echo "phone: $LX_HOST   linux: $LX_GUEST"; else lx_use_arch "$1" && echo "Linux arch set to '$1' (set up on first use)."; fi; exit $?;;
esac
_t=$1
lx_has "$_t" 2>/dev/null || lx_ensure "$_t" || true
lx_run "$@"
