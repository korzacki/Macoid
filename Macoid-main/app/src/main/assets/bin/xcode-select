#!/system/bin/sh
case "$1" in
  -p|--print-path) echo /Applications/Xcode.app/Contents/Developer;;
  --install) echo "Real Xcode cannot run on a phone. What Macoid gives you instead (all on the phone, no runner):"
             echo "  - plutil, PlistBuddy, lipo, otool, install_name_tool, dwarfdump, sips run locally, instantly"
             echo "  - swift / swiftc run in the local Linux when a Swift toolchain is installed there (Debian: pkg install swiftlang)"
             echo "  - xcodebuild, codesign, simctl ... need a real Mac and are not available";;
  --version|-v) echo "xcode-select version 2399 (Macoid)";;
  *) echo "usage: xcode-select -p | --install | --version" >&2; exit 1;;
esac
