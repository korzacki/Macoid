#!/system/bin/sh
# pkg - the Macoid package installer. Everything runs ON the phone, inside a real Linux (Debian or Alpine in proot).
# No GitHub runner, no cloud: installs read straight from the distro's own mirrors.
. "$MACOID/lib/linux.sh"
sub=$1; [ $# -gt 0 ] && shift

# keep only package names (drop apt-style flags), translate known command names (python, pip, gcc ...) to this distro's packages
names() {
  for _n in "$@"; do
    case "$_n" in -*) continue;; esac
    _n=${_n%%@*}; _n=${_n%%=*}
    _p=$(lx_pkgs "$_n"); [ -n "$_p" ] && echo "$_p" || echo "$_n"
  done | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' '
}
done_note() { echo "[macoid] done. The new commands are ready to use now." >&2; }

case "$sub" in
  install|add|i)
    [ $# -eq 0 ] && die "usage: pkg install <name...>   (e.g. pkg install python ffmpeg jq)"
    lx_setup || exit 1
    pk=$(names "$@"); [ -n "$pk" ] || die "pkg: nothing to install"
    lx_pkg_add $pk && done_note;;
  remove|uninstall|rm|del|purge)
    [ $# -eq 0 ] && die "usage: pkg remove <name...>"
    lx_setup || exit 1
    pk=$(names "$@"); lx_pkg_del $pk && echo "[macoid] removed." >&2;;
  search|find)
    [ $# -eq 0 ] && die "usage: pkg search <text>"
    lx_setup || exit 1
    lx_pkg_search "$@";;
  list|ls) lx_setup || exit 1; lx_pkg_list;;
  info|show) [ $# -eq 0 ] && die "usage: pkg info <name>"; lx_setup || exit 1; lx_pkg_info "$(names "$1")";;
  update|refresh) lx_setup || exit 1; lx_pkg_update && echo "Package index updated.";;
  upgrade|full-upgrade|dist-upgrade) lx_setup || exit 1; lx_pkg_upgrade;;
  clean|autoremove|cleanup) lx_setup || exit 1; lx_pkg_clean; echo "Cleaned.";;
  shell) exec /system/bin/sh "$MACOID/bin/lx";;
  setup) lx_setup || exit 1; lx_base; lx_sync_bins; echo "Linux is ready ($LX_DISTRO, $LX_GUEST).";;
  distro) if [ $# -eq 0 ]; then echo "$LX_DISTRO"; else lx_use "$1" && echo "Linux is now '$1'. It is set up on first use (pkg setup)."; fi;;
  arch) if [ $# -eq 0 ]; then echo "phone: $LX_HOST   linux: $LX_GUEST"; else lx_use_arch "$1" && echo "Linux arch set to '$1'. Set up on first use (pkg setup)."; fi;;
  reset) [ "$1" = --yes ] || die "pkg reset deletes the current Linux ($LX_DISTRO $LX_GUEST) and everything installed in it. Run: pkg reset --yes"
         lx_reset; echo "Linux removed. It is downloaded again the next time you install something.";;
  doctor)
    echo "cpu:     $(uname -m)   phone arch: ${LX_HOST:-unsupported}   linux arch: $LX_GUEST"
    [ -x "$LXPROOT" ] && echo "[ok] proot engine" || echo "[--] proot engine not downloaded yet (pkg setup)"
    echo "distro:  $LX_DISTRO   (switch: pkg distro alpine|debian)"
    if lx_ready; then
      echo "[ok] Linux root filesystem: $(du -sk "$LXROOT" 2>/dev/null | cut -f1) KB on disk"
      echo "     $(lx_pkg_count) packages installed, $(ls "$LXWRAP" 2>/dev/null | wc -l) commands on PATH"
      echo "     stored in: $LX   (inside the app's private storage; it survives restarts and updates signed with the same key)"
      [ -f "$LXROOT/.macoid-base" ] && echo "[ok] base set installed" || echo "[--] base set (python, pip, git ...) not installed yet: run 'pkg setup'"
      for t in python3 pip3 node ruby go cargo git; do lx_has "$t" && echo "     $t: $(_lx_proot "$t" --version 2>&1 | head -1)"; done
    else echo "[--] Linux not set up yet (pkg setup; first run downloads ~30 MB)"; fi;;
  help|""|-h|--help)
    cat <<'TXT'
pkg - install software on the phone, instantly (a real Linux runs locally; no GitHub runner, no cloud)

  pkg install <name...>      install  (python pip node ruby go cargo gcc cmake ffmpeg jq ssh rsync tmux vim ...)
  pkg remove <name...>       remove
  pkg search <text>          search the package index
  pkg list | info <name>     what is installed / details
  pkg update | upgrade       refresh the index / upgrade everything
  pkg setup                  set up the Linux now and install the base set (python, pip, git, curl, ssh)
  pkg shell                  open a Linux shell      (same as: lx)
  pkg distro [debian|alpine] show / switch the Linux distro  (default: Debian 13, glibc; Alpine is smaller, musl)
  pkg arch [arm64|arm|x86_64|default]   show / choose the CPU architecture of the Linux (default: the phone's own)
  pkg doctor                 status
  pkg reset --yes            delete the current Linux

Also works: apt install ..., apt-get install ..., apk add ..., brew install ...
pip, npm, yarn, pnpm, gem, cargo and go run locally too and install on first use:
  pip install requests     npm i -g typescript     cargo install ripgrep
Run any Linux command directly with:  lx <command> ...
TXT
    ;;
  *) die "pkg: unknown command '$sub'. Try: pkg help";;
esac
